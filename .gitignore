# Version control ignore rules for MediShield

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
ENV/
env/

# Pytest / Testing / Coverage
.cache
.pytest_cache/
.coverage
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.log

# Node.js / Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
.eslintcache

# Environment Variables & Secrets (CRITICAL)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.pfx
*.keystore

# Datasets and Heavy ML Artifacts (never commit raw PCAPs or multi-GB CSVs)
ml/data/*
!ml/data/.gitkeep
!ml/data/README.md
ml/artifacts/*.joblib
ml/artifacts/*.pkl
ml/artifacts/*.onnx
!ml/artifacts/.gitkeep

# IDEs & Operating System
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

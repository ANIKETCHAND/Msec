# ==============================================================================
# MediShield Frontend Environment Configuration Template
# Copy this file to .env or .env.local to customize local frontend behavior.
# ==============================================================================

# Backend API Base URL (defaults to /api/v1 via Vite development proxy)
# In standalone mode or cloud deployment, point directly to FastAPI backend:
VITE_API_URL="http://127.0.0.1:8000"
# (VITE_API_BASE_URL is also supported as an alias)
VITE_API_BASE_URL="http://127.0.0.1:8000"

# Application Brand Metadata
VITE_APP_TITLE="MediShield — IoMT Security & Privacy Platform"
VITE_APP_VERSION="2.0.0"

# Network & Timeout Configuration (in milliseconds)
VITE_REQUEST_TIMEOUT_MS=30000

# Development Diagnostics
VITE_DEBUG_LOGS=true

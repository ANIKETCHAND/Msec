# MediShield Root Environment Configuration Template
# This file serves as a root-level reference for all environment variables used across the platform.

# =============================================================================
# Backend Configuration (.env in /backend)
# =============================================================================
PROJECT_NAME="MediShield IoMT Security & Privacy Platform"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG="True"
HOST="127.0.0.1"
PORT=8000
API_V1_STR="/api"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Cryptography & Security Secrets
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="dev_insecure_secret_key_change_in_production_32chars"
AES_GCM_SECRET_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Supabase / PostgreSQL Credentials (Phases 3-4)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-public-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-secret-service-role-key"
DATABASE_URL="postgresql://postgres:yourpassword@db.your-project-id.supabase.co:5432/postgres"

# Machine Learning Artifacts (Phase 6)
ML_MODEL_PATH="ml/artifacts/iomt_rf_model.joblib"

# =============================================================================
# Frontend Configuration (.env in /frontend)
# =============================================================================
VITE_API_BASE_URL="http://127.0.0.1:8000"
VITE_APP_TITLE="MediShield — IoMT Security & Privacy Platform"
